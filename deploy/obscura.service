[Unit]
Description=Obscura Studio private AI image generator
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/obscura-studio
Environment=ART_HOST=127.0.0.1
Environment=ART_PORT=8080
Environment=ART_DATA_DIR=/var/lib/obscura
Environment=ART_IMAGE_DIR=/var/lib/obscura/images
Environment=ART_SECRET_KEY=change-this-long-random-secret
ExecStart=/usr/bin/python3 /opt/obscura-studio/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
